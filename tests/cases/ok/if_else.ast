ProgramNode @1:1
  body:
    DeclStmt type_name='int' is_const=False name='a' @1:1
    IfStmt @2:1
      cond:
        BinaryExpr op='!=' @2:6
          left:
            IdentExpr name='a' @2:4
          right:
            NumberExpr text='0' @2:9
      then_block:
        BlockNode @3:1
          body:
            AssignStmt name='a' @3:2
              value:
                NumberExpr text='1' @3:6
      else_block:
        BlockNode @5:1
          body:
            AssignStmt name='a' @5:2
              value:
                NumberExpr text='2' @5:6
    ExitStmt @6:1
      value:
        IdentExpr name='a' @6:6
