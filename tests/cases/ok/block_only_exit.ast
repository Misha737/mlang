ProgramNode @1:1
  structs:
  functions:
  statements:
    DeclStmt type_name='int' is_const=False name='a' @1:1
    IfStmt @2:1
      cond:
        BinaryExpr op='==' @2:6
          left:
            IdentExpr name='a' @2:4
          right:
            NumberExpr text='1' @2:9
      then_block:
        BlockNode @3:1
          body:
            ExitStmt @3:2
              value:
                NumberExpr text='1' @3:7
  exit:
    ExitStmt @4:1
      value:
        NumberExpr text='0' @4:6
