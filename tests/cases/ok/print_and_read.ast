ProgramNode @1:1
  structs:
  functions:
  statements:
    DeclStmt type_name='int' is_const=False name='n' @1:1
      init:
        ReadExpr @1:9
    PrintStmt @2:1
      value:
        StringExpr text='n is' @2:7
    PrintStmt @3:1
      value:
        BinaryExpr op='+' @3:9
          left:
            IdentExpr name='n' @3:7
          right:
            NumberExpr text='1' @3:11
  exit:
    ExitStmt @4:1
      value:
        IdentExpr name='n' @4:6
